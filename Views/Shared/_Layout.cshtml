<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quote Tracker</title>
    <link rel="icon" type="image/png" href="~/book.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header class="mb-4 d-flex align-items-center justify-content-between px-4">
        <div class="my-2 d-flex align-items-center justify-content-evenly">
            <img class="header-img" src="./book.png" alt="">
            <h1>Quote Tracker</h1>
        </div>
        <nav class="d-flex justify-content-evenly">
            <a asp-controller="Home" asp-action="Index" class="button primary text-decoration-none fs-4 mx-2">Verses</a>
            <a asp-controller="BookPage" asp-action="Index"
                class="button primary text-decoration-none fs-4 mx-2">Books</a>
            <a asp-controller="TopicPage" asp-action="Index"
                class="button primary text-decoration-none fs-4 mx-2">Topics</a>
        </nav>
    </header>

    <div class="">
        <main role="main" class="">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
